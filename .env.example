# ─────────────────────────────────────────────────────────────
# نمونه تنظیمات محیط — این فایل را به «.env» کپی کنید:
#   لوکال (ویندوز/مک/لینوکس):   cp .env.example .env
#   مقادیر واقعی را مطابق پایگاه داده خودتان تغییر دهید.
# ─────────────────────────────────────────────────────────────

# ═══ نصب لوکال (Postgres محلی یا Docker روی خود سیستم) ═══
# — در لوکال Connection Pooler نداریم؛ DIRECT_URL دقیقاً برابر DATABASE_URL است.
# — sslmode=disable برای پستگرس لوکال (بدون TLS) لازم است.
# — اگر رمز عبور کاراکترهای خاص (# @ / : ?  و …) دارد، آن را URL-Encode کنید؛
#   مثال: رمز «Ab#1404»  →  Ab%231404
DATABASE_URL="postgresql://makan:makan123@localhost:5432/makan?sslmode=disable"
DIRECT_URL="postgresql://makan:makan123@localhost:5432/makan?sslmode=disable"

# ═══ هاست / پروداکشن (مثل Supabase / Neon) ═══
# — برای Prisma دو اتصال لازم است:
#     DATABASE_URL  → اتصال روزمرهٔ برنامه از طریق Connection Pooler (پورت 6543 در Supabase)
#     DIRECT_URL    → اتصال مستقیم فقط برای مایگریشن‌ها (پورت 5432)
# — کاراکتر # در رمز عبور باید به %23 تبدیل شود.
# — Supabase: در انتهای رشتهٔ pooled پارامتر pgbouncer=true و sslmode=require بگذارید.
#
# DATABASE_URL="postgresql://postgres:YOUR-PASS%23WORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://postgres:YOUR-PASS%23WORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require"
#
# Neon (پورت ۵۴۳۲ به‌صورت خودکار pooled است):
# DATABASE_URL="postgresql://user:pass@ep-name-region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-name-region.aws.neon.tech/neondb?sslmode=require"

# ─── اختیاری ───
# ADMIN_PASSWORD=Admin#1404        # رمز مدیر هنگام Seed (اگر خالی باشد رمز تصادفی در db/.initial-admin-password.txt ذخیره می‌شود)
# GOOGLE_CLIENT_ID=...             # ورود با گوگل (تنظیم از پنل مدیریت هم امکان‌پذیر است)
# GOOGLE_CLIENT_SECRET=...
